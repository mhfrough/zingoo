PORT=3020
CORS_ORIGIN=http://localhost:4270

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=zingo_db
DB_SYNC=true
DB_LOGGING=false
